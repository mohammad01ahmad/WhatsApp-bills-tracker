# OpenRouter — required. Vision extraction. (The model is hardcoded in
# src/llm/client.ts — dots-studio/dots-3-note-preview:free — not set here.)
OPENROUTER_API_KEY=

# Supabase — the bills-tracker project. The service role key bypasses RLS for
# backend writes; never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Which table to read/write. BLANK → bills_testing (the safe default for local
# testing). Production sets this to `bills`. If TARGET_CHAT_JID is set (production)
# and this is blank, the process refuses to boot rather than write real expenses
# into the test table.
BILLS_TABLE=

# The one chat to watch.
#   BLANK  → self-chat mode: the bot watches the linked account's own self-chat.
#            This is the testing path — nothing to configure.
#   set    → production: the business group's ...@g.us JID. To find it, leave this
#            blank, add the bot to the group, have someone post — the bot logs the
#            group's JID once ("saw a message in a chat this bot is not watching").
TARGET_CHAT_JID=

# Optional. pino level, also controls Baileys' own logs.
# trace|debug|info|warn|error|fatal|silent. Default: info.
LOG_LEVEL=

# No env var for WhatsApp auth — the session lives in ./auth_session (gitignored,
# treat as a credential). First boot prints a QR to stdout; scan it once from the
# bot number's WhatsApp -> Linked Devices.
